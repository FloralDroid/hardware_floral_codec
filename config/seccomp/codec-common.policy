# Copyright 2026 FloralDroid
# SPDX-License-Identifier: Apache-2.0
# Binder, V4L2/DRM, dma-buf, worker threads and crash reporting only.
# This filter does not authorize paths or ioctl commands; SELinux/DAC remain
# separate controls, and the host's device policy must be checked independently.
read: 1
write: 1
readv: 1
writev: 1
pread64: 1
close: 1
dup: 1
dup3: 1
fcntl: 1
ioctl: 1
openat: 1
newfstatat: 1
fstat: 1
fstatfs: 1
lseek: 1
getdents64: 1
readlinkat: 1
faccessat: 1
mmap: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
# 3 is MREMAP_MAYMOVE | MREMAP_FIXED (Android 12 minijail has no parentheses).
mremap: arg3 == MREMAP_MAYMOVE || arg3 == 3
munmap: 1
madvise: 1
memfd_create: 1
ftruncate: 1
futex: 1
clone: arg0 & CLONE_THREAD
set_tid_address: 1
set_robust_list: 1
sched_yield: 1
sched_getaffinity: 1
sched_setaffinity: 1
sched_getscheduler: 1
sched_setscheduler: 1
sched_getparam: 1
sched_setparam: 1
getpriority: 1
setpriority: 1
getrlimit: 1
prlimit64: 1
clock_gettime: 1
clock_nanosleep: 1
nanosleep: 1
gettimeofday: 1
getrandom: 1
uname: 1
# Turnip queries physical memory while initializing the Vulkan system heap.
sysinfo: 1
getpid: 1
getppid: 1
gettid: 1
getuid: 1
geteuid: 1
getgid: 1
getegid: 1
getgroups: 1
prctl: 1
rt_sigaction: 1
rt_sigprocmask: 1
rt_sigreturn: 1
rt_tgsigqueueinfo: 1
sigaltstack: 1
tgkill: 1
restart_syscall: 1
exit: 1
exit_group: 1
ppoll: 1
eventfd2: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
pipe2: 1
socket: arg0 == AF_UNIX
socketpair: arg0 == AF_UNIX
connect: 1
getsockopt: 1
setsockopt: 1
recvmsg: 1
sendmsg: 1
recvfrom: 1
sendto: 1
shutdown: 1
# Android's crash dumper uses this syscall; task access still requires SELinux
# and ptrace/DAC authorization. Seccomp cannot compare against runtime getpid().
process_vm_readv: 1
